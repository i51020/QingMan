/* 青蔓 QingMan · 布局（锐利新拟物 + 三栏职责） */

#app {
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* 顶栏 */
#topbar {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--qm-gap);
  padding: 8px 14px;
  background: var(--qm-surface);
  border-bottom: 1px solid var(--qm-line);
  box-shadow: 0 1px 2px var(--qm-shadow-dark);
}
/* 品牌区样式见 base.css（主界面与帮助页共用） */

.topbar-right { display: flex; align-items: center; gap: var(--qm-gap); }

/* 三栏主体 */
#main {
  flex: 1 1 auto;
  min-height: 0;
  display: grid;
  grid-template-columns: 240px minmax(360px, 1fr) 280px;
  gap: var(--qm-gap);
  padding: var(--qm-gap);
}

#sidebar, #center, #inspector {
  min-height: 0;
  background: var(--qm-surface);
  border: 1px solid var(--qm-line);
  border-radius: var(--qm-r-md);
  display: flex;
  flex-direction: column;
  box-shadow:
    3px 3px 8px var(--qm-shadow-dark),
    -2px -2px 6px var(--qm-shadow-light),
    inset .5px .5px 1px var(--qm-edge-hi);
}

#sidebar, #inspector { padding: var(--qm-gap); overflow: auto; }

.panel-title {
  font-size: 12px;
  letter-spacing: 1px;
  color: var(--qm-text-dim);
  text-transform: none;
  margin-bottom: 8px;
}
.panel-sub {
  font-size: 12px;
  color: var(--qm-text-dim);
  margin: 14px 0 6px;
}
.panel-block { margin-top: 16px; }

.checklist { list-style: none; margin: 0; padding: 0; }
.checklist li {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 3px 0;
  color: var(--qm-text-dim);
  font-size: 12px;
}
.checklist li::before {
  content: "○";
  color: var(--qm-text-dim);
  font-size: 11px;
}
.checklist li.is-ok { color: var(--qm-accent-ink); }
.checklist li.is-ok::before { content: "●"; color: var(--qm-accent); }
.checklist li.is-bad { color: var(--qm-danger); }
.checklist li.is-bad::before { content: "●"; color: var(--qm-danger); }

/* ---------- 左栏：模板列表（V0.0.11） ---------- */

.tpl-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }

.tpl-item {
  /* 铺满整行：模板名长度不一，固定宽度会截断中文名 */
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  padding: 6px 8px;
  border: 1px solid var(--qm-line-soft);
  border-radius: var(--qm-r-sm);
  background: var(--qm-surface-2);
  box-shadow: var(--qm-shadow);
  color: var(--qm-text);
  font-size: 12px;
  text-align: left;
  cursor: pointer;
}
.tpl-item:hover { background: var(--qm-accent-soft); border-color: var(--qm-accent); }
.tpl-item:active { box-shadow: var(--qm-inset); }

.tpl-name { font-weight: 600; line-height: 1.3; }
.tpl-stats { color: var(--qm-text-dim); font-size: 11px; }

.tpl-empty { color: var(--qm-text-dim); font-size: 12px; padding: 4px 0; }
.tpl-empty.tpl-warn { color: var(--qm-warn); }

/* 中栏 */
#center { background: var(--qm-surface); padding: 0; overflow: hidden; }

.center-head {
  flex: 0 0 auto;
  padding: var(--qm-gap) var(--qm-gap) 0;
  border-bottom: 1px solid var(--qm-line-soft);
}
.center-head .panel-title { margin-bottom: 8px; }

.bar {
  flex: 0 0 auto;
  display: flex;
  align-items: flex-end;
  gap: var(--qm-gap);
  padding: var(--qm-gap);
  border-bottom: 1px solid var(--qm-line-soft);
  flex-wrap: wrap;
}
#toolbar { align-items: center; border-bottom: 1px solid var(--qm-line-soft); }

/* 生成参数区：可折叠。
   参数是"一个项目设一次"的低频项，却长期占据一整行 —— 折叠后只留摘要行，
   关键设定（目标位置 / 根名 / 演练或写盘）仍一眼可见。 */
#genBar {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: var(--qm-gap);
  border-bottom: 1px solid var(--qm-line-soft);
}
.genbar-head {
  appearance: none;
  display: flex;
  align-items: center;
  gap: 6px;
  width: 100%;
  padding: 1px 0;
  border: 0;
  background: transparent;
  color: var(--qm-text-dim);
  font-family: inherit;
  font-size: 12px;
  text-align: left;
  cursor: pointer;
}
.genbar-head:hover { color: var(--qm-accent-ink); }
.genbar-head:focus-visible {
  outline: 2px solid var(--qm-accent-soft);
  border-radius: var(--qm-r-sm);
}
.genbar-caret { flex: 0 0 auto; font-size: 10px; }
.genbar-summary {
  flex: 1 1 auto;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.genbar-fields {
  display: flex;
  align-items: flex-end;
  gap: var(--qm-gap);
  flex-wrap: wrap;
}
#genBar.is-collapsed .genbar-fields { display: none; }

.field { display: flex; flex-direction: column; gap: 3px; min-width: 150px; }
.field-wide { flex: 1 1 240px; }
.field > span { font-size: 11px; color: var(--qm-text-dim); }

.switch { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--qm-text-dim); padding-bottom: 4px; }

#treeWrap {
  flex: 1 1 auto;
  min-height: 0;
  overflow: auto;
  padding: 8px 10px;
}

#treeCanvas { outline: none; }

.tree-node { }
.tree-row {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 3px 6px;
  border-radius: var(--qm-r-sm);
  cursor: pointer;
  user-select: none;
  border: 1px solid transparent;
}
.tree-row:hover {
  background: var(--qm-line-soft);
  box-shadow: inset 1px 1px 2px var(--qm-shadow-light), inset -1px -1px 2px var(--qm-shadow-dark);
}
.tree-row.is-selected {
  background: var(--qm-accent-soft);
  color: var(--qm-accent-ink);
  border-color: var(--qm-accent-soft);
  box-shadow: var(--qm-inset);
}
.tree-toggle {
  width: 14px;
  text-align: center;
  color: var(--qm-text-dim);
  font-size: 10px;
  flex: 0 0 auto;
}
.tree-toggle.is-leaf { visibility: hidden; }
.tree-icon { flex: 0 0 auto; font-size: 12px; }
.tree-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tree-children { margin-left: 16px; border-left: 1px dashed var(--qm-line); padding-left: 4px; }
.tree-children.is-collapsed { display: none; }

#statusBar {
  flex: 0 0 auto;
  display: flex;
  justify-content: space-between;
  gap: var(--qm-gap);
  padding: 6px 12px;
  border-top: 1px solid var(--qm-line-soft);
  color: var(--qm-text-dim);
  font-size: 12px;
  background: var(--qm-surface-2);
}
.status-count { font-family: var(--qm-mono); }

/* 右栏 */
.prop-list { display: flex; flex-direction: column; gap: 2px; }
.prop { display: flex; gap: 8px; align-items: baseline; }
.prop-key { flex: 0 0 56px; color: var(--qm-text-dim); font-size: 12px; }
.prop-val { flex: 1 1 auto; word-break: break-all; }
.prop-mono { font-size: 11px; color: var(--qm-text-dim); }

.result {
  margin: 0;
  padding: 8px;
  background: var(--qm-surface-2);
  border: 1px solid var(--qm-line-soft);
  border-radius: var(--qm-r-sm);
  white-space: pre-wrap;
  word-break: break-all;
  max-height: 240px;
  overflow: auto;
  color: var(--qm-text-dim);
  box-shadow: var(--qm-inset);
}

/* 提示条 */
.toast-host {
  position: fixed;
  right: 16px;
  bottom: 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  z-index: 50;
  pointer-events: none;
}
.toast {
  background: var(--qm-surface-2);
  border: 1px solid var(--qm-line);
  border-left: 3px solid var(--qm-accent);
  border-radius: var(--qm-r-sm);
  box-shadow: var(--qm-shadow-raise);
  padding: 8px 12px;
  font-size: 12px;
  max-width: 380px;
}
.toast.is-error { border-left-color: var(--qm-danger); }
.toast.is-warn { border-left-color: var(--qm-warn); }
