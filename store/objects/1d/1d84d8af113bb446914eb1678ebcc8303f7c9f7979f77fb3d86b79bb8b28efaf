/* 青蔓 QingMan · 帮助页样式
 *
 * 纪律（docs/项目约定.md §P0-3 L4）：
 *   - 色彩、圆角、间距一律取 var(--qm-*)，本文件不出现任何裸色值
 *   - 结构尺寸（最大宽度、栅格列宽、断点）沿用 layout.css 既有做法，用裸 px
 *   - 组件样式不感知皮肤，不写 `.skin-x .yyy` 这类选择器
 */

.help-page { min-height: 100%; }

/* 裸链接的兜底色（2026-10-17）。
 *
 * 为什么必须有：帮助页正文里由 `help.js` 渲染的跳转链接（如「赞赏与支持」）
 * 只是 `<a href>`，**没有 class** —— 此前没有任何规则命中它，于是落到浏览器
 * 默认的链接蓝 `#0000EE`。它在浅色皮肤上勉强可见，但在深色皮肤上对比度只有
 * **1.17–1.70**（实测，门禁 4.5），等于看不见。
 *
 * 用 `--qm-accent-ink` 而不是 `--qm-accent`：前者是各皮肤刻意钳制过的**文字**色
 * （「强调文字 / 面板」在 18 个配色面上全部 ≥ 4.5），后者是非文本图形色。
 * 元素选择器优先级最低，`.btn` / `.help-nav-list a` 等类选择器仍会正常覆盖它。
 */
a { color: var(--qm-accent-ink); }

#helpApp {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 顶栏 */
#helpTopbar {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--qm-gap);
  padding: 8px 14px;
  background: var(--qm-surface);
  border-bottom: 1px solid var(--qm-line);
}
#helpTopbar .topbar-right {
  display: flex;
  align-items: center;
  gap: var(--qm-gap);
}
#helpTopbar a.btn { text-decoration: none; }

/* 主体：窄栏锚点 + 宽栏正文 */
#helpMain {
  flex: 1 1 auto;
  width: 100%;
  max-width: 860px;
  margin: 0 auto;
  padding: 18px var(--qm-gap) 32px;
  display: grid;
  grid-template-columns: 150px minmax(0, 1fr);
  gap: 18px;
  align-items: start;
}

#helpNav {
  background: var(--qm-surface);
  border: 1px solid var(--qm-line);
  border-radius: var(--qm-r-md);
  padding: var(--qm-gap);
}
.help-nav-list { list-style: none; margin: 0; padding: 0; }
.help-nav-list li { padding: 2px 0; }
.help-nav-list a {
  color: var(--qm-text-dim);
  text-decoration: none;
  font-size: var(--qm-fs-md);
  display: block;
}
.help-nav-list a:hover { color: var(--qm-accent-ink); }

#helpBody { min-width: 0; }

.help-lead {
  margin: 0 0 16px;
  font-size: var(--qm-fs-2xl);
  line-height: 1.8;
  color: var(--qm-text);
}

/* 分节 */
.help-section {
  background: var(--qm-surface);
  border: 1px solid var(--qm-line);
  border-radius: var(--qm-r-md);
  padding: 12px 14px;
  margin-bottom: var(--qm-gap);
  box-shadow:
    2px 2px 6px var(--qm-shadow-dark),
    -1px -1px 4px var(--qm-shadow-light),
    inset .5px .5px 1px var(--qm-edge-hi);
}
.help-section-title {
  font-size: var(--qm-fs-xl);
  font-weight: 600;
  color: var(--qm-accent-ink);
  margin: 0 0 8px;
}

.help-list { margin: 0; padding-left: 20px; }
.help-list li {
  font-size: var(--qm-fs-md);
  line-height: 1.9;
  color: var(--qm-text-dim);
}
.help-note li {
  list-style: none;
  margin-left: -20px;
  color: var(--qm-warn);
}
.help-note li::before { content: "· "; color: var(--qm-warn); }

/* 关于表 */
.help-table { width: 100%; border-collapse: collapse; font-size: var(--qm-fs-md); }
.help-table th, .help-table td {
  text-align: left;
  vertical-align: top;
  padding: 5px 8px;
  border-bottom: 1px solid var(--qm-line-soft);
}
.help-table th {
  width: 96px;
  font-weight: 400;
  color: var(--qm-text-dim);
}
.help-table td { color: var(--qm-text); word-break: break-all; }
.help-table tr:last-child th, .help-table tr:last-child td { border-bottom: none; }

/* 快捷键表（kind: 'kbd'）：左键帽 / 右说明，两列对齐 —— 扫一眼即可把「按什么键」与「做什么」对上 */
.help-kbd { width: 100%; border-collapse: collapse; font-size: var(--qm-fs-md); }
.help-kbd th {
  text-align: left;
  font-weight: 400;
  vertical-align: top;
  white-space: nowrap;
  width: 1%;
  padding: 5px 12px 5px 0;
}
.help-kbd td { color: var(--qm-text-dim); vertical-align: top; padding: 5px 0; }
.help-kbd tr + tr th, .help-kbd tr + tr td { border-top: 1px solid var(--qm-line-soft); }
.help-kbd kbd {
  display: inline-block;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: var(--qm-fs-xs);
  line-height: 1.6;
  padding: 1px 6px;
  color: var(--qm-text);
  background: var(--qm-surface-2);
  border: 1px solid var(--qm-line);
  border-radius: var(--qm-r-sm);
  box-shadow: var(--qm-inset);
  white-space: nowrap;
}
.help-kbd-or { margin: 0 5px; font-size: var(--qm-fs-xs); color: var(--qm-text-dim); }
.help-kbd-note {
  margin: 9px 0 0;
  font-size: var(--qm-fs-sm);
  line-height: 1.7;
  color: var(--qm-text-dim);
}
/* V0.0.51@r6：「版本与关于」表下的操作说明（模板库位置怎么改）。
   与 .help-kbd-note 同款，但语义不同，故另立类名而非复用。 */
.help-about-note {
  margin: 9px 0 0;
  font-size: var(--qm-fs-sm);
  line-height: 1.7;
  color: var(--qm-text-dim);
}

/* .help-foot-note 随 about.note 一并删除（V0.0.41 · 手册 10.2 节 #10）——
   那条脚注是设计纪律而非给用户读的文字，帮助页不再渲染，样式亦无引用。 */
.help-stale { color: var(--qm-warn); }

/* 支持区块 */
.help-support {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  flex-wrap: wrap;
}
.help-qr {
  margin: 0;
  padding: 10px;
  background: var(--qm-surface-2);
  border: 1px solid var(--qm-line);
  border-radius: var(--qm-r-md);
  box-shadow: var(--qm-inset);
}
.help-qr img {
  display: block;
  width: 180px;
  height: auto;
  border-radius: var(--qm-r-sm);
}
.help-qr figcaption {
  margin-top: 6px;
  text-align: center;
  font-size: var(--qm-fs-md);
  color: var(--qm-text-dim);
}
.help-thanks {
  flex: 1 1 200px;
  margin: 0;
  font-size: var(--qm-fs-md);
  line-height: 1.9;
  color: var(--qm-text-dim);
}

/* 页脚 */
#helpFooter {
  flex: 0 0 auto;
  padding: 8px 14px;
  border-top: 1px solid var(--qm-line-soft);
  color: var(--qm-text-dim);
  font-size: var(--qm-fs-md);
  text-align: center;
}

/* 窄屏：锚点折叠到正文之上 */
@media (max-width: 720px) {
  #helpMain { grid-template-columns: minmax(0, 1fr); }
  #helpNav { order: 2; }
  .help-nav-list { display: flex; flex-wrap: wrap; gap: 4px var(--qm-gap); }
}
