# ── Python ──────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── 本项目自有机制 ──────────────────────────────────────
# checkout 回收区：临时产物，不入过程历史（版本数据见 store/objects 与 versions）
store/.trash/

# ── 运行时数据（非交付内容） ────────────────────────────
# 编辑态文档：由 GET/PUT /api/editor 读写，属用户数据，不进版本清单也不进过程历史
# 见 docs/项目约定.md §P0-7「编辑态数据契约与持久化」
data/

# ── 编辑器 / 操作系统 ───────────────────────────────────
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini

# ── 临时产物 ────────────────────────────────────────────
*.log
